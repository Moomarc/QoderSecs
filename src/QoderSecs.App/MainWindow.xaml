<Window x:Class="QoderSecs.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QoderSecs"
        Width="1360"
        Height="860"
        MinWidth="860"
        MinHeight="680"
        Background="#F3F4F6"
        FontFamily="Segoe UI"
        FontSize="13"
        PreviewMouseDown="WindowPreviewMouseDown">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D8DEE8" />
        <SolidColorBrush x:Key="MutedBrush" Color="#667085" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="3" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Margin" Value="0,4,8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="0,4,8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="TopBarButtonStyle" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="3" />
        </Style>
        <!-- 左栏「文件」是 Menu，默认比旁边的 Button 矮一截也窄一截，按 Button 的尺寸对齐。
             必须 BasedOn 主题默认样式：MenuItem 靠 Role 触发器换模板，覆盖掉就展不开子菜单了。 -->
        <Style x:Key="ToolbarMenuStyle"
               BasedOn="{StaticResource {x:Type MenuItem}}"
               TargetType="MenuItem">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- 挂在 TreeViewItem 上而不是行内容上：整行（含展开箭头）右键都能出菜单。
             共享实例，DataContext 由 PlacementTarget 继承，所以绑定照旧走节点 VM。
             两个添加项按节点类型收掉：非列表元素加不了子项、根元素没有同级，
             留着只会让人点下去看状态栏报错。 -->
        <ContextMenu x:Key="NodeContextMenu">
            <MenuItem Header="添加子项"
                      Visibility="{Binding AddChildVisibility}"
                      ItemsSource="{Binding Owner.ItemTypeOptions}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem">
                        <Setter Property="Header" Value="{Binding Header}" />
                        <Setter Property="Command"
                                Value="{Binding DataContext.Owner.AddChildCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Setter Property="CommandParameter" Value="{Binding Type}" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="添加同级"
                      Visibility="{Binding AddSiblingVisibility}"
                      ItemsSource="{Binding Owner.ItemTypeOptions}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem">
                        <Setter Property="Header" Value="{Binding Header}" />
                        <Setter Property="Command"
                                Value="{Binding DataContext.Owner.AddSiblingCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Setter Property="CommandParameter" Value="{Binding Type}" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <Separator Visibility="{Binding AddSeparatorVisibility}" />
            <MenuItem Header="删除" Command="{Binding Owner.DeleteNodeCommand}" />
            <Separator />
            <MenuItem Header="复制"
                      InputGestureText="Ctrl+C"
                      Command="{Binding Owner.CopyNodeCommand}" />
            <MenuItem Header="粘贴"
                      InputGestureText="Ctrl+V"
                      Command="{Binding Owner.PasteNodeCommand}" />
            <Separator />
            <Separator Visibility="{Binding SaveAsEntryVisibility}" />
            <MenuItem Header="存为条目"
                      Visibility="{Binding SaveAsEntryVisibility}"
                      Command="{Binding Owner.SaveNodeAsEntryCommand}"
                      ToolTip="把这个节点整份存进数据字典，之后可以复制粘贴到别的消息里；改条目不会动这条消息" />
        </ContextMenu>

        <!-- 两棵树共用同一套行样式：结构页那棵和字典页那棵都是 SECS-II 子树，
             一行上要看的东西一模一样（类型色块、名字、值预览、就地那两个框）。
             写两份迟早会漂移成「字典那棵不能双击改名」这一类毛病。 -->
        <Style x:Key="StructureNodeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="ContextMenu" Value="{StaticResource NodeContextMenu}" />
            <!-- TreeViewItem 的 UIA 名字默认取数据项的 ToString，
                 走查和读屏都读不出这一行是什么，必须显式给。 -->
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <EventSetter Event="PreviewMouseRightButtonDown"
                         Handler="SelectNodeOnRightClick" />
            <Style.Triggers>
                <!-- 只有正在编辑的那一行拉满宽度，值框才吃得到 * 列；
                     显示态不拉，长值预览照旧把行撑宽，行为不变。 -->
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <HierarchicalDataTemplate x:Key="StructureNodeRowTemplate" ItemsSource="{Binding Children}">
            <!-- 显示态和编辑态叠在同一行上，靠 IsEditing 切：双击行或 F2 进编辑，
                 点到这一行以外、选中挪走、整棵树重建就退出。两个框绑的还是 EditName / EditValue，
                 边敲边写、红框实时校验，和底部那两个框同一套语义（2026-10-18 定）。
                 多行值（A / J）在行内只占一行，改长内容仍走底部那块。 -->
            <Grid>
                <StackPanel Orientation="Horizontal" ToolTip="{Binding ValidationError}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Margin="0,1,6,1"
                            Padding="5,0"
                            Background="{Binding BadgeBrush}"
                            CornerRadius="3">
                        <TextBlock FontFamily="Cascadia Mono"
                                   FontSize="11"
                                   Foreground="White"
                                   Text="{Binding TypeLabel}" />
                    </Border>
                    <TextBlock VerticalAlignment="Center" Text="{Binding DisplayName}" />
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding ValuePreview}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                                        <Setter Property="Foreground" Value="#DC2626" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" MinWidth="120" />
                    </Grid.ColumnDefinitions>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Border Margin="0,1,6,1"
                            Padding="5,0"
                            VerticalAlignment="Center"
                            Background="{Binding BadgeBrush}"
                            CornerRadius="3">
                        <TextBlock FontFamily="Cascadia Mono"
                                   FontSize="11"
                                   Foreground="White"
                                   Text="{Binding TypeLabel}" />
                    </Border>
                    <TextBox Grid.Column="1"
                             VerticalAlignment="Center"
                             AutomationProperties.Name="节点名称"
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="可选，例如 PPID / COMMACK；留空就是没有名字" />
                    <Grid Grid.Column="2">
                        <TextBox VerticalAlignment="Center"
                                 AcceptsReturn="False"
                                 AutomationProperties.Name="节点值"
                                 Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="NoWrap"
                                 ToolTip="{Binding ValueEditorTip}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowsValueEditor}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                                            <Setter Property="BorderBrush" Value="#DC2626" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="FocusManager.FocusedElement"
                                                    Value="{Binding RelativeSource={RelativeSource Self}}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <ComboBox Width="90"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="节点值"
                                  ItemsSource="{Binding BooleanOptions}"
                                  SelectedItem="{Binding EditValue}">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowsBooleanEditor}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="{Binding ValueNote}"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowsValueNote}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Grid>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Command="{Binding CloseConfigPanelCommand}" Key="Escape" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="TopBar"
                Grid.Row="0"
                Padding="12,9"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Margin="0,0,18,0"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="QoderSecs" />

                <TextBlock Grid.Column="1"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           AutomationProperties.AutomationId="ProfileSummary"
                           Foreground="{StaticResource MutedBrush}"
                           Text="{Binding ConfigurationSummary}" />

                <ToggleButton x:Name="ConfigPanelToggle"
                              Grid.Column="2"
                              IsChecked="{Binding IsConfigPanelOpen, Mode=TwoWay}"
                              Style="{StaticResource TopBarButtonStyle}"
                              Content="连接参数 ▾" />

                <Border Grid.Column="3"
                        Margin="8,0"
                        Padding="10,5"
                        VerticalAlignment="Center"
                        Background="#F2F4F7"
                        CornerRadius="12">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8"
                                 Height="8"
                                 VerticalAlignment="Center"
                                 Fill="{Binding PhaseBrush}" />
                        <TextBlock x:Name="PhasePill"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="{Binding PhaseText}" />
                    </StackPanel>
                </Border>

                <Button x:Name="ConnectButton"
                        Grid.Column="4"
                        MinWidth="88"
                        Command="{Binding ConnectCommand}"
                        Content="{Binding ConnectButtonText}" />

                <Popup AllowsTransparency="True"
                       HorizontalOffset="12"
                       IsOpen="{Binding IsConfigPanelOpen, Mode=TwoWay}"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=TopBar}"
                       StaysOpen="True"
                       VerticalOffset="8">
                    <Border MaxWidth="940"
                            Margin="14,6,14,16"
                            Padding="14"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16"
                                              Opacity="0.22"
                                              ShadowDepth="2" />
                        </Border.Effect>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource SectionTitleStyle}"
                                           Text="连接参数" />
                                <Button Width="26"
                                        Height="26"
                                        Margin="0"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        Command="{Binding CloseConfigPanelCommand}"
                                        Content="✕"
                                        ToolTip="关闭 (Esc)" />
                            </DockPanel>
                            <WrapPanel IsEnabled="{Binding AreParametersEditable}">
                                <StackPanel Width="145">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="角色" />
                                    <ComboBox AutomationProperties.AutomationId="ProfileRole"
                                              ItemsSource="{Binding EndpointRoles}"
                                              SelectedItem="{Binding Role}" />
                                </StackPanel>
                                <StackPanel Width="145">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="传输方式" />
                                    <ComboBox AutomationProperties.AutomationId="ProfileTransport"
                                              DisplayMemberPath="Display"
                                              ItemsSource="{Binding TransportOptions}"
                                              SelectedValuePath="Kind"
                                              SelectedValue="{Binding Transport, Mode=TwoWay}">
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem">
                                                <!-- 和自动回复那栏一样：不给名字，UIA 读出来是 TransportOption 的 ToString。 -->
                                                <Setter Property="AutomationProperties.Name" Value="{Binding Display}" />
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                    </ComboBox>                                </StackPanel>
                                <StackPanel Width="105">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Device ID" />
                                    <TextBox AutomationProperties.AutomationId="ProfileDeviceId"
                                             Text="{Binding DeviceId}" />
                                </StackPanel>
                                <StackPanel Width="90">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="T3 (s)" />
                                    <TextBox AutomationProperties.AutomationId="ProfileT3"
                                             Text="{Binding T3Seconds}" />
                                </StackPanel>
                            </WrapPanel>

                            <!-- HSMS 那一套：网络四元组加 T5–T8 和 Linktest。 -->
                            <WrapPanel Margin="0,8,0,0"
                                       IsEnabled="{Binding AreParametersEditable}"
                                       Visibility="{Binding HsmsSettingsVisibility}">
                                <StackPanel Width="145">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="模式" />
                                    <ComboBox AutomationProperties.AutomationId="ProfileMode"
                                              ItemsSource="{Binding ConnectionModes}"
                                              SelectedItem="{Binding Mode}" />
                                </StackPanel>
                                <StackPanel Width="180">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="IP 地址" />
                                    <TextBox AutomationProperties.AutomationId="ProfileIpAddress"
                                             Text="{Binding IpAddress, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Width="105">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Port" />
                                    <TextBox AutomationProperties.AutomationId="ProfilePort"
                                             Text="{Binding Port}" />
                                </StackPanel>
                            </WrapPanel>
                            <WrapPanel Margin="0,8,0,0"
                                       IsEnabled="{Binding AreParametersEditable}"
                                       Visibility="{Binding HsmsSettingsVisibility}">
                                <StackPanel Width="90">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="T5 (s)" />
                                    <TextBox AutomationProperties.AutomationId="ProfileT5"
                                             Text="{Binding T5Seconds}" />
                                </StackPanel>
                                <StackPanel Width="90">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="T6 (s)" />
                                    <TextBox AutomationProperties.AutomationId="ProfileT6"
                                             Text="{Binding T6Seconds}" />
                                </StackPanel>
                                <StackPanel Width="90">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="T7 (s)" />
                                    <TextBox AutomationProperties.AutomationId="ProfileT7"
                                             Text="{Binding T7Seconds}" />
                                </StackPanel>
                                <StackPanel Width="90">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="T8 (s)" />
                                    <TextBox AutomationProperties.AutomationId="ProfileT8"
                                             Text="{Binding T8Seconds}" />
                                </StackPanel>
                                <StackPanel Width="190" Margin="12,0,0,0">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Linktest" />
                                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                        <CheckBox Margin="0,0,10,0"
                                                  VerticalAlignment="Center"
                                                  Content="启用"
                                                  IsChecked="{Binding LinkTestEnabled}" />
                                        <TextBox Width="70"
                                                 IsEnabled="{Binding LinkTestEnabled}"
                                                 Text="{Binding LinkTestIntervalSeconds}" />
                                        <TextBlock VerticalAlignment="Center" Text="秒" />
                                    </StackPanel>
                                </StackPanel>
                            </WrapPanel>

                            <!-- SECS-I 那一套：串口参数加 T1/T2/T4。 -->
                            <WrapPanel Margin="0,8,0,0"
                                       IsEnabled="{Binding AreParametersEditable}"
                                       Visibility="{Binding Secs1SettingsVisibility}">
                                <StackPanel Width="120">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="串口" />
                                    <TextBox AutomationProperties.AutomationId="ProfileSerialPort"
                                             Text="{Binding SerialPortName, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Width="110">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="波特率" />
                                    <TextBox AutomationProperties.AutomationId="ProfileBaudRate"
                                             Text="{Binding BaudRate}" />
                                </StackPanel>
                                <StackPanel Width="90">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="数据位" />
                                    <TextBox AutomationProperties.AutomationId="ProfileDataBits"
                                             Text="{Binding DataBits}" />
                                </StackPanel>
                                <StackPanel Width="100">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="校验" />
                                    <ComboBox AutomationProperties.AutomationId="ProfileParity"
                                              ItemsSource="{Binding SerialParities}"
                                              SelectedItem="{Binding Parity}" />
                                </StackPanel>
                                <StackPanel Width="110">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="停止位" />
                                    <ComboBox AutomationProperties.AutomationId="ProfileStopBits"
                                              ItemsSource="{Binding SerialStopBitOptions}"
                                              SelectedItem="{Binding StopBits}" />
                                </StackPanel>
                                <StackPanel Width="120">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="流控" />
                                    <ComboBox AutomationProperties.AutomationId="ProfileFlowControl"
                                              ItemsSource="{Binding SerialFlowControls}"
                                              SelectedItem="{Binding FlowControl}" />
                                </StackPanel>
                            </WrapPanel>
                            <WrapPanel Margin="0,8,0,0"
                                       IsEnabled="{Binding AreParametersEditable}"
                                       Visibility="{Binding Secs1SettingsVisibility}">
                                <StackPanel Width="90">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="T1 (s)" />
                                    <TextBox AutomationProperties.AutomationId="ProfileT1"
                                             Text="{Binding T1Seconds}" />
                                </StackPanel>
                                <StackPanel Width="90">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="T2 (s)" />
                                    <TextBox AutomationProperties.AutomationId="ProfileT2"
                                             Text="{Binding T2Seconds}" />
                                </StackPanel>
                                <StackPanel Width="90">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="T4 (s)" />
                                    <TextBox AutomationProperties.AutomationId="ProfileT4"
                                             Text="{Binding T4Seconds}" />
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10,8,10,8">
            <Grid.ColumnDefinitions>
                <!-- 三栏下限之和加上两条分隔条，就是窗口 MinWidth 的下界；
                     想让窗口能更窄，必须先降这里，只改 MinWidth 是拖不动的。
                     中栏不能低于 300：名称框 170 和 S/F/W 组 160 都要放得下，
                     扣掉发送按钮 98 之后只剩压盖，不会换行。
                     左栏不能低于 230：标题是 DockPanel 的填充项，
                     右边「文件 + ＋新消息」占掉 150，再窄标题就被挤成 0 宽直接消失。 -->
                <ColumnDefinition Width="2*" MinWidth="230" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="3*" MinWidth="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="4*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                <!-- 左栏整片收文件拖放。AllowDrop 挂在面板的 Grid 上而不是 ListBox 上：
                     「消息库为空」那条提示文字和 ListBox 是叠在同一格的兄弟元素，
                     只挂 ListBox 的话拖到提示那一片会因为没有 AllowDrop 的祖先而收不到。 -->
                <Grid AllowDrop="True"
                      DragOver="MessageAreaDragOver"
                      Drop="MessageAreaDrop">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="10,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Menu Margin="3" Background="Transparent">
                                <MenuItem Header="文件" Style="{StaticResource ToolbarMenuStyle}">
                                    <MenuItem Command="{Binding ImportLibraryCommand}" Header="导入 .sxml…" />
                                    <MenuItem Command="{Binding ExportLibraryCommand}" Header="导出 .sxml…" />
                                    <Separator />
                                    <MenuItem Command="{Binding ClearLibraryCommand}" Header="清空消息库…" />
                                </MenuItem>
                            </Menu>
                            <Button AutomationProperties.AutomationId="NewMessage"
                                    Command="{Binding NewMessageCommand}"
                                    Content="＋ 新消息" />
                        </StackPanel>
                        <TextBlock Margin="0,0,8,0"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Text="{Binding LibraryHeader}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding LibraryHeader}" />
                    </DockPanel>
                    <TextBox Grid.Row="1"
                             Margin="10,0,10,8"
                             AutomationProperties.Name="搜索消息"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按名称过滤，或直接输入 SxFy，例如 S10F3" />
                    <ListBox x:Name="MessageList"
                             Grid.Row="2"
                             Margin="6,0,6,6"
                             BorderThickness="0"
                             ItemsSource="{Binding Messages}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             SelectedItem="{Binding SelectedMessage, Mode=TwoWay}"
                             PreviewKeyDown="MessageListPreviewKeyDown">
                        <!-- 删除和复制的入口都在右键菜单（删除另外还绑 Delete 键，工具条那里已经满了）。
                             菜单挂在列表而不是行上，PlacementTarget 就是 ListBox，
                             菜单项的 DataContext 直接是 VM，不用绕 RelativeSource。
                             操作的是鼠标底下那一条，靠下面 ItemContainerStyle 里的右键先选中那一步。 -->
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="复制" Command="{Binding DuplicateMessageCommand}" />
                                <MenuItem Header="删除" Command="{Binding DeleteMessageCommand}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <!-- 不加这个，行的 UIA 名字就是 MessageEntry 的 ToString()，
                                     读屏软件会把整段 XML 念一遍，自动化测试也没法精确断言。 -->
                                <Setter Property="AutomationProperties.Name">
                                    <Setter.Value>
                                        <MultiBinding StringFormat="{}{0} {1} {2}">
                                            <Binding Path="Signature" />
                                            <Binding Path="WBitMark" />
                                            <Binding Path="Name" />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="ToolTip" Value="{x:Null}" />
                                <EventSetter Event="PreviewMouseRightButtonDown"
                                             Handler="SelectMessageOnRightClick" />
                                <Style.Triggers>
                                    <!-- 空描述不挂空 ToolTip，否则鼠标停上去会弹一个空白小框。 -->
                                    <DataTrigger Binding="{Binding HasDescription}" Value="True">
                                        <Setter Property="ToolTip" Value="{Binding Description}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="60"
                                               Margin="0,0,6,0"
                                               FontFamily="Cascadia Mono"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               Text="{Binding Signature}" />
                                    <TextBlock Width="14"
                                               Margin="0,0,6,0"
                                               FontFamily="Cascadia Mono"
                                               TextAlignment="Center"
                                               ToolTip="这条消息要求对方回复（W-Bit）"
                                               Text="{Binding WBitMark}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding WBit}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2"
                               Margin="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               Text="{Binding EmptyHint}"
                               TextAlignment="Center"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMessages}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Margin="10,4,8,4"
                               Style="{StaticResource SectionTitleStyle}"
                               Text="消息编辑" />
                    <Grid Grid.Row="1" Margin="10,0,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- 名称/S/F/W/自动回复排一行，描述单独占一行：
                             中栏只有 3*，固定宽度分组一旦超过剩余宽度，右边框会被裁掉。 -->
                        <Grid IsEnabled="{Binding HasSelectedMessage}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="名称" />
                                <TextBox AutomationProperties.AutomationId="MessageName"
                                         AutomationProperties.Name="消息名称"
                                         KeyDown="CommitOnEnter"
                                         ToolTip="同一个 SxFy 可以有多条消息，全靠这个名字区分（自动回复也是按它指向的）；不能留空，也不能和别的消息重名"
                                         Text="{Binding MessageName, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Width="48">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="S" />
                                <TextBox AutomationProperties.AutomationId="MessageStream"
                                         AutomationProperties.Name="消息 Stream"
                                         KeyDown="CommitOnEnter"
                                         Text="{Binding StreamText, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Width="48" Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="F" />
                                <TextBox AutomationProperties.AutomationId="MessageFunction"
                                         AutomationProperties.Name="消息 Function"
                                         KeyDown="CommitOnEnter"
                                         Text="{Binding FunctionText, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <CheckBox Grid.Column="3"
                                      Margin="10,0,0,7"
                                      VerticalAlignment="Bottom"
                                      AutomationProperties.AutomationId="MessageWBit"
                                      AutomationProperties.Name="消息 W 位"
                                      Content="W"
                                      IsChecked="{Binding MessageWBit}"
                                      ToolTip="这条消息要求对方回复（W-Bit）" />
                            <StackPanel Grid.Column="4" Margin="12,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="{Binding AutoReplyFieldLabel}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding AutoReplyFieldLabel}" />
                                <ComboBox AutomationProperties.AutomationId="MessageAutoReply"
                                          AutomationProperties.Name="{Binding AutoReplyFieldLabel}"
                                          DisplayMemberPath="Display"
                                          ItemsSource="{Binding AutoReplyCandidates}"
                                          SelectedItem="{Binding MessageAutoReply}"
                                          ToolTip="收到这条消息时自动回哪一条。候选写的是「SxF · 名字」，当前值由下拉框的选中高亮表示；v1 只支持指向单条消息，程序按名字精确回">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <!-- 不加这个，下拉项的 UIA 名字就是 AutoReplyOption 的 ToString()，
                                                 读屏软件念一串字段名，自动化也断言不到「SxF · 名字」那段文案。
                                                 和左栏消息行同一个做法。 -->
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Display}" />
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <DockPanel Grid.Row="1" Margin="0,8,0,0">
                            <!-- 发送放在描述行右侧：这样上面那行字段能排齐，按钮也不会压住任何输入框。 -->
                            <Button x:Name="SendButton"
                                    Width="90"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Bottom"
                                    DockPanel.Dock="Right"
                                    Command="{Binding SendCommand}"
                                    Content="发送" />
                            <!-- 带 W 的消息在途时发送按键必然变灰（一次只发一条），
                                 没有这个按钮的话等待只能靠 T3 到点，观感就是程序卡死。 -->
                            <Button Width="90"
                                    Margin="0,0,0,0"
                                    VerticalAlignment="Bottom"
                                    DockPanel.Dock="Right"
                                    Visibility="{Binding CancelSendVisibility}"
                                    Command="{Binding CancelSendCommand}"
                                    Content="取消等待" />
                            <StackPanel IsEnabled="{Binding HasSelectedMessage}">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="描述" />
                                <TextBox AutomationProperties.AutomationId="MessageDescription"
                                         AutomationProperties.Name="消息描述"
                                         KeyDown="CommitOnEnter"
                                         ToolTip="这条消息的用途说明；清空后左栏悬停不再显示"
                                         Text="{Binding MessageDescription, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                    <TabControl Grid.Row="2"
                                Margin="8,0"
                                SelectedIndex="{Binding EditorTab}">
                        <TabItem Header="结构">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Menu Margin="2,4,0,0" Background="Transparent">
                                    <MenuItem Header="添加子项" ItemsSource="{Binding ItemTypeOptions}">
                                        <MenuItem.ItemContainerStyle>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Header" Value="{Binding Header}" />
                                                <Setter Property="Command"
                                                        Value="{Binding DataContext.AddChildCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                                                <Setter Property="CommandParameter" Value="{Binding Type}" />
                                            </Style>
                                        </MenuItem.ItemContainerStyle>
                                    </MenuItem>
                                    <MenuItem Header="添加同级" ItemsSource="{Binding ItemTypeOptions}">
                                        <MenuItem.ItemContainerStyle>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Header" Value="{Binding Header}" />
                                                <Setter Property="Command"
                                                        Value="{Binding DataContext.AddSiblingCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                                                <Setter Property="CommandParameter" Value="{Binding Type}" />
                                            </Style>
                                        </MenuItem.ItemContainerStyle>
                                    </MenuItem>
                                    <MenuItem Header="删除" Command="{Binding DeleteNodeCommand}" />
                                    <Separator />
                                    <MenuItem Header="复制"
                                              InputGestureText="Ctrl+C"
                                              Command="{Binding CopyNodeCommand}" />
                                    <MenuItem Header="粘贴"
                                              InputGestureText="Ctrl+V"
                                              Command="{Binding PasteNodeCommand}" />
                                    <Separator />
                                    <MenuItem Header="存为条目"
                                              Command="{Binding SaveNodeAsEntryCommand}"
                                              ToolTip="把这个节点整份存进数据字典，之后可以复制粘贴到别的消息里；改条目不会动这条消息" />
                                </Menu>
                                <TreeView x:Name="StructureTree"
                                          Grid.Row="1"
                                          Margin="4,0,4,4"
                                          BorderThickness="0"
                                          AllowDrop="True"
                                          ItemContainerStyle="{StaticResource StructureNodeItemStyle}"
                                          ItemTemplate="{StaticResource StructureNodeRowTemplate}"
                                          ItemsSource="{Binding StructureRootItems}"
                                          PreviewMouseLeftButtonDown="NodeTreePreviewMouseLeftButtonDown"
                                          MouseMove="NodeTreeMouseMove"
                                          DragOver="NodeTreeDragOver"
                                          DragLeave="NodeTreeDragLeave"
                                          Drop="NodeTreeDrop"
                                          MouseDoubleClick="NodeTreeMouseDoubleClick"
                                          PreviewKeyDown="NodeTreePreviewKeyDown">
                                </TreeView>
                                <TextBlock Grid.Row="1"
                                           Margin="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="{Binding StructureHint}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StructureHint}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Grid.Row="2"
                                        Padding="8,6"
                                        Background="#F8FAFC"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,1,0,0">
                                    <Grid DataContext="{Binding SelectedNode}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Text="选中一个节点后，在这里改名称和值。">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Border Margin="0,1,8,1"
                                                    Padding="5,0"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding BadgeBrush}"
                                                    CornerRadius="3">
                                                <TextBlock FontFamily="Cascadia Mono"
                                                           FontSize="11"
                                                           Foreground="White"
                                                           Text="{Binding TypeLabel}" />
                                            </Border>
                                            <TextBlock Margin="0,0,6,0"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource FieldLabelStyle}"
                                                       Text="名称" />
                                            <TextBox Width="150"
                                                     Margin="0,0,12,0"
                                                     VerticalAlignment="Center"
                                                     AutomationProperties.Name="节点名称"
                                                     Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="可选，例如 PPID / COMMACK；留空就是没有名字" />
                                            <TextBlock Margin="0,0,6,0"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource FieldLabelStyle}"
                                                       Text="值" />
                                            <TextBox Width="240"
                                                     Margin="0,0,12,0"
                                                     VerticalAlignment="Center"
                                                     AutomationProperties.Name="节点值"
                                                     AcceptsReturn="{Binding IsMultiLineValue}"
                                                     Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}"
                                                     LostFocus="StructureValueLostFocus"
                                                     TextWrapping="Wrap"
                                                     ToolTip="{Binding ValueEditorTip}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="MinHeight" Value="30" />
                                                        <Setter Property="Padding" Value="7,4" />
                                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowsValueEditor}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMultiLineValue}" Value="True">
                                                                <Setter Property="Height" Value="64" />
                                                                <Setter Property="VerticalContentAlignment" Value="Top" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#DC2626" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <ComboBox Width="90"
                                                      Margin="0,0,12,0"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.Name="节点值"
                                                      ItemsSource="{Binding BooleanOptions}"
                                                      SelectedItem="{Binding EditValue}">
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox">
                                                        <Setter Property="MinHeight" Value="30" />
                                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowsBooleanEditor}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.Style>
                                            </ComboBox>
                                            <TextBlock VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Text="{Binding ValueNote}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowsValueNote}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1"
                                                   Margin="0,4,0,0"
                                                   Foreground="#DC2626"
                                                   Text="{Binding ValidationError}"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>
                        <TabItem Header="SML">
                            <Grid Margin="4,4,4,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="96" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox BorderThickness="0"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         AutomationProperties.Name="SML 预览"
                                         FontFamily="Cascadia Mono"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextWrapping="NoWrap"
                                         Text="{Binding SmlPreviewText, Mode=OneWay}"
                                         VerticalScrollBarVisibility="Auto">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SmlPreviewHasError}" Value="True">
                                                    <Setter Property="Foreground" Value="#DC2626" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <TextBlock Grid.Row="1"
                                           Margin="0,6,0,2"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="粘贴一条完整消息的 SML（带 SxFy 消息头），覆盖当前消息的消息头和结构：" />
                                <TextBox Grid.Row="2"
                                         AcceptsReturn="True"
                                         AutomationProperties.Name="粘贴 SML"
                                         FontFamily="Cascadia Mono"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextWrapping="NoWrap"
                                         Text="{Binding PasteSmlText, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalScrollBarVisibility="Auto" />
                                <Button Grid.Row="3"
                                        Width="120"
                                        Margin="0,6,0,0"
                                        HorizontalAlignment="Right"
                                        Command="{Binding ApplySmlCommand}"
                                        Content="覆盖当前消息" />
                            </Grid>
                        </TabItem>
                        <!-- 数据字典：单独存起来的 data 和 list，给别的消息当素材。
                             条目和消息之间是复制关系，两边改了都不影响对方。 -->
                        <TabItem Header="数据字典">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Menu Grid.Row="0" Margin="2,4,0,0" Background="Transparent">
                                    <MenuItem Header="新增数据" ItemsSource="{Binding ItemTypeOptions}">
                                        <MenuItem.ItemContainerStyle>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Header" Value="{Binding Header}" />
                                                <Setter Property="Command"
                                                        Value="{Binding DataContext.NewEntryCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                                                <Setter Property="CommandParameter" Value="{Binding Type}" />
                                            </Style>
                                        </MenuItem.ItemContainerStyle>
                                    </MenuItem>
                                    <MenuItem Header="删除条目"
                                              Command="{Binding DeleteEntryCommand}"
                                              ToolTip="只删字典里这一条，已经复制进消息的那些内容不受影响" />
                                    <Separator />
                                    <MenuItem Header="复制"
                                              InputGestureText="Ctrl+C"
                                              Command="{Binding CopyNodeCommand}" />
                                    <MenuItem Header="粘贴"
                                              InputGestureText="Ctrl+V"
                                              Command="{Binding PasteNodeCommand}" />
                                </Menu>
                                <Grid Grid.Row="1" Margin="4,0,4,4">
                                    <!-- 一个条目就是一个顶层节点，不垫假根行：条目之间互不隶属，
                                         垫一行会让人以为整本字典能像消息体那样拖来拖去。
                                         树里可以就地改名字和值、加子项、删某一层，和结构页那一棵同一套操作；
                                         要跨到消息里去只能复制粘贴，拖动过不去（Core 把跨段那一刀拦了）。 -->
                                    <TreeView x:Name="EntryTree"
                                              BorderThickness="0"
                                              AllowDrop="True"
                                              ItemContainerStyle="{StaticResource StructureNodeItemStyle}"
                                              ItemTemplate="{StaticResource StructureNodeRowTemplate}"
                                              ItemsSource="{Binding EntryRootItems}"
                                              PreviewMouseLeftButtonDown="NodeTreePreviewMouseLeftButtonDown"
                                              MouseMove="NodeTreeMouseMove"
                                              DragOver="NodeTreeDragOver"
                                              DragLeave="NodeTreeDragLeave"
                                              Drop="NodeTreeDrop"
                                              MouseDoubleClick="NodeTreeMouseDoubleClick"
                                              PreviewKeyDown="NodeTreePreviewKeyDown" />
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="{Binding EntryHint}" />
                                </Grid>
                                <StackPanel Grid.Row="2" Margin="4,0,4,6">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="条目名称" />
                                    <TextBox AutomationProperties.Name="条目名称"
                                             KeyDown="CommitOnEnter"
                                             IsEnabled="{Binding HasSelectedDataEntry}"
                                             ToolTip="改名字不影响已经复制进消息的内容；数据元素的名字可以留空、也可以重名"
                                             Text="{Binding DataEntryName, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3"
                          HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.2*" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource PanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="10,8"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Text="{Binding RecordsTitle}" />
                        <Grid Grid.Row="1"
                              Margin="8,0,8,8">
                            <ListView x:Name="RecordList"
                                      ItemsSource="{Binding Records}"
                                      SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="时间"
                                                        Width="104"
                                                        DisplayMemberBinding="{Binding TimeText}" />
                                        <GridViewColumn Header="方向"
                                                        Width="46"
                                                        DisplayMemberBinding="{Binding DirectionText}" />
                                        <!-- 名称长了会裁，裁了必须能悬停看全，不然只能去翻日志。 -->
                                        <GridViewColumn Header="消息" Width="140">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding MessageText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding MessageText}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="SystemBytes"
                                                        Width="92"
                                                        DisplayMemberBinding="{Binding SystemBytesText}" />
                                        <GridViewColumn Header="状态"
                                                        Width="112"
                                                        DisplayMemberBinding="{Binding StatusText}" />
                                        <GridViewColumn Header="耗时"
                                                        Width="62"
                                                        DisplayMemberBinding="{Binding ElapsedText}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="{Binding RecordsHint}" />
                        </Grid>
                    </Grid>
                </Border>
                <GridSplitter Grid.Row="1"
                              VerticalAlignment="Stretch"
                              HorizontalAlignment="Stretch"
                              Background="Transparent" />
                <Border Grid.Row="2" Style="{StaticResource PanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="10,8"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Text="详情" />
                        <TextBox x:Name="RecordDetailBox"
                                 Grid.Row="1"
                                 Margin="8,0,8,8"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 FontFamily="Cascadia Mono"
                                 HorizontalScrollBarVisibility="Auto"
                                 MouseDoubleClick="ToggleDetailExpand"
                                 Text="{Binding RecordDetail, Mode=OneWay}"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 ToolTip="大消息的正文折叠着，双击展开或收起" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Padding="10,5"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <!-- 出错时变红：状态栏一句话要能区分「刚才那句是报错了」还是「已保存」这类提示。 -->
            <TextBlock AutomationProperties.AutomationId="StatusBar"
                       Foreground="{Binding StatusBrush}"
                       Text="{Binding StatusMessage}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding StatusMessage}" />
        </Border>
    </Grid>
</Window>
