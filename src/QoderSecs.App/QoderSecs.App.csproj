<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\QoderSecs.Core\QoderSecs.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 样本消息库编进 exe。启动时发现数据目录里没有这个文件就解出来一份，之后归用户，
         所以发布目录只需要一个 exe，不再单独带 samples 出去。
         解出来不等于加载：自动回复仍然默认不开，程序仍然不内置规则。
         只带这一份 GEM 常用命令骨架；S12 上下图那两条在它里面，但正文留空。
         文件名必须和 AppDataPaths.SampleFileName 一字不差，否则运行时按后缀找不到资源。 -->
    <EmbeddedResource Include="..\..\samples\common-commands.sxml"
                      Link="samples\common-commands.sxml" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- 资源管理器、快捷方式和任务栏用的就是这个图标。
         16/24/32/48 是无压缩的位图条目，256 是 PNG 条目，缺了哪一档系统在对应尺寸上就会模糊。 -->
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- 发布落点固定为仓库根的 release\；bin 下只是编译缓存，不是发布目录。 -->
    <PublishDir>$(MSBuildThisFileDirectory)..\..\release\</PublishDir>
  </PropertyGroup>

</Project>
