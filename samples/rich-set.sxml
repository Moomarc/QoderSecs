<SXML>
    <DataDictionary>
    </DataDictionary>
    <MessageDictionary>
        <Message Name="AreYouThere" Description="在线查询，无正文">
            <Stream>1</Stream>
            <Function>1</Function>
            <WBit>1</WBit>
            <AutoReply>OnlineData</AutoReply>
            <Structure />
        </Message>
        <Message Name="OnlineData" Description="回 S1F1：机型与软件版本">
            <Stream>1</Stream>
            <Function>2</Function>
            <Structure>
                <L>
                    <A Name="MDLN">
                        <Value />
                        <Maps Type="4096">
                        </Maps>
                    </A>
                    <A Name="SOFTREV">
                        <Value />
                        <Maps Type="4096">
                        </Maps>
                    </A>
                </L>
            </Structure>
        </Message>
        <Message Name="StatusRequest" Description="按 SVID 查询状态变量">
            <Stream>1</Stream>
            <Function>3</Function>
            <WBit>1</WBit>
            <AutoReply>StatusData</AutoReply>
            <Structure>
                <L>
                    <U4 Name="SVID">
                        <Value />
                        <Maps Type="64">
                        </Maps>
                    </U4>
                </L>
            </Structure>
        </Message>
        <Message Name="StatusData" Description="按请求顺序返回 SV 值">
            <Stream>1</Stream>
            <Function>4</Function>
            <Structure>
                <L>
                </L>
            </Structure>
        </Message>
        <Message Name="StatusVariableNamelist" Description="查询 SV 名称表，应答 S1F12">
            <Stream>1</Stream>
            <Function>11</Function>
            <WBit>1</WBit>
            <Structure>
                <L>
                </L>
            </Structure>
        </Message>
        <Message Name="EstablishComms" Description="建立通信，无正文">
            <Stream>1</Stream>
            <Function>13</Function>
            <WBit>1</WBit>
            <AutoReply>EstablishCommsAck</AutoReply>
            <Structure />
        </Message>
        <Message Name="EstablishCommsAck" Description="COMMACK=0 接受">
            <Stream>1</Stream>
            <Function>14</Function>
            <Structure>
                <L>
                    <B Name="COMMACK">
                        <Value />
                        <Maps Type="1024">
                        </Maps>
                    </B>
                    <L>
                        <A Name="MDLN">
                            <Value />
                            <Maps Type="4096">
                            </Maps>
                        </A>
                        <A Name="SOFTREV">
                            <Value />
                            <Maps Type="4096">
                            </Maps>
                        </A>
                    </L>
                </L>
            </Structure>
        </Message>
        <Message Name="RequestOffline" Description="请求离线，无正文">
            <Stream>1</Stream>
            <Function>15</Function>
            <WBit>1</WBit>
            <AutoReply>RequestOfflineAck</AutoReply>
            <Structure />
        </Message>
        <Message Name="RequestOfflineAck" Description="OFLACK=0 接受">
            <Stream>1</Stream>
            <Function>16</Function>
            <Structure>
                <B Name="OFLACK">
                    <Value />
                    <Maps Type="1024">
                    </Maps>
                </B>
            </Structure>
        </Message>
        <Message Name="RequestOnline" Description="请求上线，无正文">
            <Stream>1</Stream>
            <Function>17</Function>
            <WBit>1</WBit>
            <AutoReply>RequestOnlineAck</AutoReply>
            <Structure />
        </Message>
        <Message Name="RequestOnlineAck" Description="ONLACK=0 接受，1 拒绝，2 已在线">
            <Stream>1</Stream>
            <Function>18</Function>
            <Structure>
                <B Name="ONLACK">
                    <Value />
                    <Maps Type="1024">
                    </Maps>
                </B>
            </Structure>
        </Message>
        <Message Name="DateTimeSet" Description="设置时间，TIME 为 12 位">
            <Stream>2</Stream>
            <Function>31</Function>
            <WBit>1</WBit>
            <AutoReply>DateTimeSetAck</AutoReply>
            <Structure>
                <A Name="TIME">
                    <Value />
                    <Maps Type="4096">
                    </Maps>
                </A>
            </Structure>
        </Message>
        <Message Name="DateTimeSetAck" Description="TIACK=0 成功，1 失败">
            <Stream>2</Stream>
            <Function>32</Function>
            <Structure>
                <B Name="TIACK">
                    <Value />
                    <Maps Type="1024">
                    </Maps>
                </B>
            </Structure>
        </Message>
        <Message Name="DefineReport" Description="定义报告：RPTID 与 VID 列表">
            <Stream>2</Stream>
            <Function>33</Function>
            <WBit>1</WBit>
            <Structure>
                <L>
                    <U4 Name="DATAID">
                        <Value />
                        <Maps Type="64">
                        </Maps>
                    </U4>
                    <L Name="RPTIDList">
                        <L>
                            <U4 Name="RPTID">
                                <Value />
                                <Maps Type="64">
                                </Maps>
                            </U4>
                            <L Name="VIDList">
                                <U4 Name="VID">
                                    <Value />
                                    <Maps Type="64">
                                    </Maps>
                                </U4>
                            </L>
                        </L>
                    </L>
                </L>
            </Structure>
        </Message>
        <Message Name="LinkEventReport" Description="报告挂接到 CEID">
            <Stream>2</Stream>
            <Function>35</Function>
            <WBit>1</WBit>
            <Structure>
                <L>
                    <U4 Name="DATAID">
                        <Value />
                        <Maps Type="64">
                        </Maps>
                    </U4>
                    <L Name="CEIDList">
                        <L>
                            <U4 Name="CEID">
                                <Value />
                                <Maps Type="64">
                                </Maps>
                            </U4>
                            <L Name="RPTIDList">
                                <U4 Name="RPTID">
                                    <Value />
                                    <Maps Type="64">
                                    </Maps>
                                </U4>
                            </L>
                        </L>
                    </L>
                </L>
            </Structure>
        </Message>
        <Message Name="EnableDisableEvents" Description="CEED 为真开启报告；CEID 列表为空表示全部">
            <Stream>2</Stream>
            <Function>37</Function>
            <WBit>1</WBit>
            <Structure>
                <L>
                    <B Name="CEED">
                        <Value />
                        <Maps Type="1024">
                        </Maps>
                    </B>
                    <L Name="CEIDList">
                        <U4 Name="CEID">
                            <Value />
                            <Maps Type="64">
                            </Maps>
                        </U4>
                    </L>
                </L>
            </Structure>
        </Message>
        <Message Name="HostCommand" Description="远程命令 RCMD；参数表可空">
            <Stream>2</Stream>
            <Function>41</Function>
            <WBit>1</WBit>
            <AutoReply>HostCommandAck</AutoReply>
            <Structure>
                <L>
                    <A Name="RCMD">
                        <Value />
                        <Maps Type="4096">
                        </Maps>
                    </A>
                    <L Name="CPList">
                    </L>
                </L>
            </Structure>
        </Message>
        <Message Name="HostCommandAck" Description="HCACK=0 可执行；逐参数回 CPACK">
            <Stream>2</Stream>
            <Function>42</Function>
            <Structure>
                <L>
                    <B Name="HCACK">
                        <Value />
                        <Maps Type="1024">
                        </Maps>
                    </B>
                    <L Name="CPList">
                        <L>
                            <A Name="CPNAME">
                                <Value />
                                <Maps Type="4096">
                                </Maps>
                            </A>
                            <B Name="CPACK">
                                <Value />
                                <Maps Type="1024">
                                </Maps>
                            </B>
                        </L>
                    </L>
                </L>
            </Structure>
        </Message>
        <Message Name="AlarmReport" Description="ALCD 最高位为 1 表示告警发生">
            <Stream>5</Stream>
            <Function>1</Function>
            <WBit>1</WBit>
            <AutoReply>AlarmReportAck</AutoReply>
            <Structure>
                <L>
                    <B Name="ALCD">
                        <Value />
                        <Maps Type="1024">
                        </Maps>
                    </B>
                    <U4 Name="ALID">
                        <Value />
                        <Maps Type="64">
                        </Maps>
                    </U4>
                    <A Name="ALTX">
                        <Value />
                        <Maps Type="4096">
                        </Maps>
                    </A>
                </L>
            </Structure>
        </Message>
        <Message Name="AlarmReportAck" Description="告警应答">
            <Stream>5</Stream>
            <Function>2</Function>
            <Structure>
                <B Name="ACK">
                    <Value />
                    <Maps Type="1024">
                    </Maps>
                </B>
            </Structure>
        </Message>
        <Message Name="EventReport" Description="CEID 与报告数据">
            <Stream>6</Stream>
            <Function>11</Function>
            <WBit>1</WBit>
            <AutoReply>EventReportAck</AutoReply>
            <Structure>
                <L>
                    <U4 Name="DATAID">
                        <Value />
                        <Maps Type="64">
                        </Maps>
                    </U4>
                    <U4 Name="CEID">
                        <Value />
                        <Maps Type="64">
                        </Maps>
                    </U4>
                    <L Name="ReportList">
                        <L>
                            <U4 Name="RPTID">
                                <Value />
                                <Maps Type="64">
                                </Maps>
                            </U4>
                            <L Name="Report">
                            </L>
                        </L>
                    </L>
                </L>
            </Structure>
        </Message>
        <Message Name="EventReportAck" Description="事件应答">
            <Stream>6</Stream>
            <Function>12</Function>
            <Structure>
                <B Name="ACK">
                    <Value />
                    <Maps Type="1024">
                    </Maps>
                </B>
            </Structure>
        </Message>
        <Message Name="ProcessProgramSend" Description="下发配方：PPID 与 PPBODY">
            <Stream>7</Stream>
            <Function>3</Function>
            <WBit>1</WBit>
            <Structure>
                <L>
                    <A Name="PPID">
                        <Value />
                        <Maps Type="4096">
                        </Maps>
                    </A>
                    <A Name="PPBODY">
                        <Value />
                        <Maps Type="4096">
                        </Maps>
                    </A>
                </L>
            </Structure>
        </Message>
        <Message Name="ProcessProgramRequest" Description="读取配方：PPID">
            <Stream>7</Stream>
            <Function>5</Function>
            <WBit>1</WBit>
            <Structure>
                <A Name="PPID">
                    <Value />
                    <Maps Type="4096">
                    </Maps>
                </A>
            </Structure>
        </Message>
        <Message Name="DeleteProcessProgram" Description="删除配方；PPID 列表为空表示全部">
            <Stream>7</Stream>
            <Function>17</Function>
            <WBit>1</WBit>
            <Structure>
                <L>
                    <A Name="PPID">
                        <Value />
                        <Maps Type="4096">
                        </Maps>
                    </A>
                </L>
            </Structure>
        </Message>
        <Message Name="CurrentEPPDRequest" Description="查询配方清单，无正文；应答 S7F20">
            <Stream>7</Stream>
            <Function>19</Function>
            <WBit>1</WBit>
            <Structure />
        </Message>
        <Message Name="TerminalDisplaySingle" Description="屏幕显示：TID 与 TEXT">
            <Stream>10</Stream>
            <Function>3</Function>
            <WBit>1</WBit>
            <Structure>
                <L>
                    <B Name="TID">
                        <Value />
                        <Maps Type="1024">
                        </Maps>
                    </B>
                    <A Name="TEXT">
                        <Value />
                        <Maps Type="4096">
                        </Maps>
                    </A>
                </L>
            </Structure>
        </Message>
        <Message Name="WaferMap" Description="上传晶圆图">
            <Stream>12</Stream>
            <Function>9</Function>
            <WBit>1</WBit>
            <Structure>
                <L>
                    <A Name="LOTID">
                        <Value />
                        <Maps Type="4096">
                        </Maps>
                    </A>
                    <B Name="WAFERID">
                        <Value />
                        <Maps Type="1024">
                        </Maps>
                    </B>
                    <I2 Name="MAP_XY">
                        <Value />
                    </I2>
                    <A Name="WAFER_MAP">
                        <Value />
                        <Maps Type="4096">
                        </Maps>
                    </A>
                </L>
            </Structure>
        </Message>
        <Message Name="WaferMapAck" Description="晶圆图应答，结构同 S12F9">
            <Stream>12</Stream>
            <Function>16</Function>
            <Structure>
                <L>
                    <A Name="LOTID">
                        <Value />
                        <Maps Type="4096">
                        </Maps>
                    </A>
                    <B Name="WAFERID">
                        <Value />
                        <Maps Type="1024">
                        </Maps>
                    </B>
                    <I2 Name="MAP_XY">
                        <Value />
                    </I2>
                    <A Name="WAFER_MAP">
                        <Value />
                        <Maps Type="4096">
                        </Maps>
                    </A>
                </L>
            </Structure>
        </Message>
    </MessageDictionary>
</SXML>
