<SXML>
    <DataDictionary>
    </DataDictionary>
    <MessageDictionary>
        <Message Name="AreYouThere" Description="在位查询，不带正文">
            <Stream>1</Stream>
            <Function>1</Function>
            <WBit>1</WBit>
            <AutoReply>OnlineData</AutoReply>
            <Structure />
        </Message>
        <Message Name="OnlineData" Description="回复 S1F1，带机型和软件版本">
            <Stream>1</Stream>
            <Function>2</Function>
            <Structure>
                <L>
                    <A Name="MDLN">
                        <Value />
                        <Maps Type="4096">
                        </Maps>
                    </A>
                    <A Name="SOFT">
                        <Value />
                        <Maps Type="4096">
                        </Maps>
                    </A>
                </L>
            </Structure>
        </Message>
        <Message Name="StatusRequest" Description="要查的状态变量 ID 依次列在里面">
            <Stream>1</Stream>
            <Function>3</Function>
            <WBit>1</WBit>
            <AutoReply>StatusData</AutoReply>
            <Structure>
                <L>
                    <U4 Name="SVID">
                        <Value />
                        <Maps Type="64">
                        </Maps>
                    </U4>
                </L>
            </Structure>
        </Message>
        <Message Name="StatusData" Description="按 S1F3 里 SVID 的顺序回值，变量名和类型由机台定">
            <Stream>1</Stream>
            <Function>4</Function>
            <Structure>
                <L>
                </L>
            </Structure>
        </Message>
        <Message Name="StatusVariableNamelist" Description="请求 SV 名称表，回信是 S1F12">
            <Stream>1</Stream>
            <Function>11</Function>
            <WBit>1</WBit>
            <Structure>
                <L>
                </L>
            </Structure>
        </Message>
        <Message Name="EstablishComms" Description="建立通信，不带正文">
            <Stream>1</Stream>
            <Function>13</Function>
            <WBit>1</WBit>
            <AutoReply>EstablishCommsAck</AutoReply>
            <Structure />
        </Message>
        <Message Name="EstablishCommsAck" Description="COMMACK=0 表示接受">
            <Stream>1</Stream>
            <Function>14</Function>
            <Structure>
                <L>
                    <B Name="COMMACK">
                        <Value />
                        <Maps Type="1024">
                        </Maps>
                    </B>
                    <L>
                        <A Name="MDLN">
                            <Value />
                            <Maps Type="4096">
                            </Maps>
                        </A>
                        <A Name="SOFT">
                            <Value />
                            <Maps Type="4096">
                            </Maps>
                        </A>
                    </L>
                </L>
            </Structure>
        </Message>
        <Message Name="RequestOffline" Description="请求设备离线，不带正文">
            <Stream>1</Stream>
            <Function>15</Function>
            <WBit>1</WBit>
            <AutoReply>RequestOfflineAck</AutoReply>
            <Structure />
        </Message>
        <Message Name="RequestOfflineAck" Description="OFLACK=0 表示接受">
            <Stream>1</Stream>
            <Function>16</Function>
            <Structure>
                <B Name="OFLACK">
                    <Value />
                    <Maps Type="1024">
                    </Maps>
                </B>
            </Structure>
        </Message>
        <Message Name="RequestOnline" Description="请求设备上线，不带正文">
            <Stream>1</Stream>
            <Function>17</Function>
            <WBit>1</WBit>
            <AutoReply>RequestOnlineAck</AutoReply>
            <Structure />
        </Message>
        <Message Name="RequestOnlineAck" Description="ONLACK=0 表示接受，1 表示拒绝，2 表示已经在线">
            <Stream>1</Stream>
            <Function>18</Function>
            <Structure>
                <B Name="ONLACK">
                    <Value />
                    <Maps Type="1024">
                    </Maps>
                </B>
            </Structure>
        </Message>
        <Message Name="DateTimeSet" Description="设置机台时间，DATETIME 是 12 位数字">
            <Stream>2</Stream>
            <Function>31</Function>
            <WBit>1</WBit>
            <AutoReply>DateTimeSetAck</AutoReply>
            <Structure>
                <A Name="DATETIME">
                    <Value />
                    <Maps Type="4096">
                    </Maps>
                </A>
            </Structure>
        </Message>
        <Message Name="DateTimeSetAck" Description="时间设置应答，TIACK=0 表示成功，1 表示失败">
            <Stream>2</Stream>
            <Function>32</Function>
            <Structure>
                <B Name="TIACK">
                    <Value />
                    <Maps Type="1024">
                    </Maps>
                </B>
            </Structure>
        </Message>
        <Message Name="DefineReport" Description="建一个上报组合：RPTID 下挂一串 SVID">
            <Stream>2</Stream>
            <Function>33</Function>
            <WBit>1</WBit>
            <Structure>
                <L>
                    <U4 Name="DATAID">
                        <Value />
                        <Maps Type="64">
                        </Maps>
                    </U4>
                    <L Name="RPTIDList">
                        <L>
                            <U4 Name="RPTID">
                                <Value />
                                <Maps Type="64">
                                </Maps>
                            </U4>
                            <L Name="SVIDList">
                                <U4 Name="SVID">
                                    <Value />
                                    <Maps Type="64">
                                    </Maps>
                                </U4>
                            </L>
                        </L>
                    </L>
                </L>
            </Structure>
        </Message>
        <Message Name="LinkEventReport" Description="把上报组合挂到收集事件上：CEID 对应一串 RPTID">
            <Stream>2</Stream>
            <Function>35</Function>
            <WBit>1</WBit>
            <Structure>
                <L>
                    <U4 Name="DATAID">
                        <Value />
                        <Maps Type="64">
                        </Maps>
                    </U4>
                    <L Name="CEEDList">
                        <L>
                            <U4 Name="CEID">
                                <Value />
                                <Maps Type="64">
                                </Maps>
                            </U4>
                            <L Name="RPTIDList">
                                <U4 Name="RPTID">
                                    <Value />
                                    <Maps Type="64">
                                    </Maps>
                                </U4>
                            </L>
                        </L>
                    </L>
                </L>
            </Structure>
        </Message>
        <Message Name="EnableDisableEvents" Description="CEED 为真开事件上报、为假关；后面的列表是 CEID，空列表表示全部">
            <Stream>2</Stream>
            <Function>37</Function>
            <WBit>1</WBit>
            <Structure>
                <L>
                    <B Name="CEED">
                        <Value />
                        <Maps Type="1024">
                        </Maps>
                    </B>
                    <L Name="CEIDList">
                        <U4 Name="CEID">
                            <Value />
                            <Maps Type="64">
                            </Maps>
                        </U4>
                    </L>
                </L>
            </Structure>
        </Message>
        <Message Name="HostCommand" Description="远程命令名加参数表；不带参数时第二个 L 留空">
            <Stream>2</Stream>
            <Function>41</Function>
            <WBit>1</WBit>
            <AutoReply>HostCommandAck</AutoReply>
            <Structure>
                <L>
                    <A Name="RCMD">
                        <Value />
                        <Maps Type="4096">
                        </Maps>
                    </A>
                    <L Name="CPList">
                    </L>
                </L>
            </Structure>
        </Message>
        <Message Name="HostCommandAck" Description="HCACK=0 表示命令可执行；每个参数名再回一个 CPACK">
            <Stream>2</Stream>
            <Function>42</Function>
            <Structure>
                <L>
                    <B Name="HCACK">
                        <Value />
                        <Maps Type="1024">
                        </Maps>
                    </B>
                    <L Name="CPList">
                        <L>
                            <A Name="CPNAME">
                                <Value />
                                <Maps Type="4096">
                                </Maps>
                            </A>
                            <B Name="CPACK">
                                <Value />
                                <Maps Type="1024">
                                </Maps>
                            </B>
                        </L>
                    </L>
                </L>
            </Structure>
        </Message>
        <Message Name="AlarmReport" Description="ALID 最高位为 1 表示告警发生">
            <Stream>5</Stream>
            <Function>1</Function>
            <WBit>1</WBit>
            <AutoReply>AlarmReportAck</AutoReply>
            <Structure>
                <L>
                    <B Name="ALID">
                        <Value />
                        <Maps Type="1024">
                        </Maps>
                    </B>
                    <A Name="ALTEXT">
                        <Value />
                        <Maps Type="4096">
                        </Maps>
                    </A>
                </L>
            </Structure>
        </Message>
        <Message Name="AlarmReportAck" Description="告警上报的应答">
            <Stream>5</Stream>
            <Function>2</Function>
            <Structure>
                <B Name="ACK">
                    <Value />
                    <Maps Type="1024">
                    </Maps>
                </B>
            </Structure>
        </Message>
        <Message Name="EventReport" Description="CEID 加上报内容，报告项里的数据由机台定">
            <Stream>6</Stream>
            <Function>11</Function>
            <WBit>1</WBit>
            <AutoReply>EventReportAck</AutoReply>
            <Structure>
                <L>
                    <U4 Name="DATAID">
                        <Value />
                        <Maps Type="64">
                        </Maps>
                    </U4>
                    <U4 Name="CEID">
                        <Value />
                        <Maps Type="64">
                        </Maps>
                    </U4>
                    <L Name="ReportList">
                        <L>
                            <U4 Name="RPTID">
                                <Value />
                                <Maps Type="64">
                                </Maps>
                            </U4>
                            <L Name="Report">
                            </L>
                        </L>
                    </L>
                </L>
            </Structure>
        </Message>
        <Message Name="EventReportAck" Description="事件上报的应答">
            <Stream>6</Stream>
            <Function>12</Function>
            <Structure>
                <B Name="ACK">
                    <Value />
                    <Maps Type="1024">
                    </Maps>
                </B>
            </Structure>
        </Message>
        <Message Name="ProcessProgramSend" Description="下发配方：PPID 加未格式化的 PPBODY">
            <Stream>7</Stream>
            <Function>3</Function>
            <WBit>1</WBit>
            <Structure>
                <L>
                    <A Name="PPID">
                        <Value />
                        <Maps Type="4096">
                        </Maps>
                    </A>
                    <A Name="PPBODY">
                        <Value />
                        <Maps Type="4096">
                        </Maps>
                    </A>
                </L>
            </Structure>
        </Message>
        <Message Name="ProcessProgramRequest" Description="按 PPID 反向读取机台里的配方">
            <Stream>7</Stream>
            <Function>5</Function>
            <WBit>1</WBit>
            <Structure>
                <A Name="PPID">
                    <Value />
                    <Maps Type="4096">
                    </Maps>
                </A>
            </Structure>
        </Message>
        <Message Name="DeleteProcessProgram" Description="删除指定 PPID，列表为空表示删除全部">
            <Stream>7</Stream>
            <Function>17</Function>
            <WBit>1</WBit>
            <Structure>
                <L>
                    <A Name="PPID">
                        <Value />
                        <Maps Type="4096">
                        </Maps>
                    </A>
                </L>
            </Structure>
        </Message>
        <Message Name="CurrentEPPDRequest" Description="查机台现有配方清单，只有报头没有正文，回信是 S7F20">
            <Stream>7</Stream>
            <Function>19</Function>
            <WBit>1</WBit>
            <Structure />
        </Message>
        <Message Name="TerminalDisplaySingle" Description="往机台屏幕发一行显示：TID 加 TEXT">
            <Stream>10</Stream>
            <Function>3</Function>
            <WBit>1</WBit>
            <Structure>
                <L>
                    <B Name="TID">
                        <Value />
                        <Maps Type="1024">
                        </Maps>
                    </B>
                    <A Name="TEXT">
                        <Value />
                        <Maps Type="4096">
                        </Maps>
                    </A>
                </L>
            </Structure>
        </Message>
        <Message Name="WaferMap" Description="上报一张上下图：批号、晶圆号、坐标对、整张图">
            <Stream>12</Stream>
            <Function>9</Function>
            <WBit>1</WBit>
            <Structure>
                <L>
                    <A Name="LOT ID">
                        <Value />
                        <Maps Type="4096">
                        </Maps>
                    </A>
                    <B Name="WAFER NO">
                        <Value />
                        <Maps Type="1024">
                        </Maps>
                    </B>
                    <I2 Name="MAP_XY">
                        <Value />
                    </I2>
                    <A Name="WAFER_MAP">
                        <Value />
                        <Maps Type="4096">
                        </Maps>
                    </A>
                </L>
            </Structure>
        </Message>
        <Message Name="WaferMapAck" Description="回一张上下图，正文形状和 S12F9 同一条">
            <Stream>12</Stream>
            <Function>16</Function>
            <Structure>
                <L>
                    <A Name="LOT ID">
                        <Value />
                        <Maps Type="4096">
                        </Maps>
                    </A>
                    <B Name="WAFER NO">
                        <Value />
                        <Maps Type="1024">
                        </Maps>
                    </B>
                    <I2 Name="MAP_XY">
                        <Value />
                    </I2>
                    <A Name="WAFER_MAP">
                        <Value />
                        <Maps Type="4096">
                        </Maps>
                    </A>
                </L>
            </Structure>
        </Message>
    </MessageDictionary>
</SXML>
