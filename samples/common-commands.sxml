<SXML>
    <DataDictionary>
    </DataDictionary>
    <MessageDictionary>
        <Message Name="S1F1_AreYouThere" Description="">
            <Stream>1</Stream>
            <Function>1</Function>
            <WBit>1</WBit>
            <AutoReply>S1F2_OnlineData</AutoReply>
            <Structure />
        </Message>
        <Message Name="S1F2_OnlineData" Description="">
            <Stream>1</Stream>
            <Function>2</Function>
            <Structure>
                <L>
                    <A Name="MDLN">
                        <Value>QODERSECS-M1</Value>
                        <Maps Type="4096">
                        </Maps>
                    </A>
                    <A Name="SOFT">
                        <Value>1.0.0</Value>
                        <Maps Type="4096">
                        </Maps>
                    </A>
                </L>
            </Structure>
        </Message>
        <Message Name="S1F3_StatusRequest" Description="查询 SVID">
            <Stream>1</Stream>
            <Function>3</Function>
            <WBit>1</WBit>
            <AutoReply>S1F4_StatusData</AutoReply>
            <Structure>
                <L>
                    <U4 Name="SVID_ControlState">
                        <Value>10001</Value>
                        <Maps Type="64">
                        </Maps>
                    </U4>
                    <U4 Name="SVID_ProcessState">
                        <Value>10002</Value>
                        <Maps Type="64">
                        </Maps>
                    </U4>
                    <U4 Name="SVID_ProcessedStripCount">
                        <Value>10003</Value>
                        <Maps Type="64">
                        </Maps>
                    </U4>
                </L>
            </Structure>
        </Message>
        <Message Name="S1F4_StatusData" Description="按 S1F3 的 SVID 顺序回">
            <Stream>1</Stream>
            <Function>4</Function>
            <Structure>
                <L>
                    <U2 Name="ControlState">
                        <Value>1</Value>
                        <Maps Type="32">
                        </Maps>
                    </U2>
                    <U2 Name="ProcessState">
                        <Value>5</Value>
                        <Maps Type="32">
                        </Maps>
                    </U2>
                    <U4 Name="ProcessedStripCount">
                        <Value>3105</Value>
                        <Maps Type="64">
                        </Maps>
                    </U4>
                </L>
            </Structure>
        </Message>
        <Message Name="S1F13_EstablishComms" Description="">
            <Stream>1</Stream>
            <Function>13</Function>
            <WBit>1</WBit>
            <AutoReply>S1F14_EstablishCommsAck</AutoReply>
            <Structure />
        </Message>
        <Message Name="S1F14_EstablishCommsAck" Description="COMMACK=0 表示接受">
            <Stream>1</Stream>
            <Function>14</Function>
            <Structure>
                <L>
                    <B Name="COMMACK">
                        <Value>00</Value>
                        <Maps Type="1024">
                        </Maps>
                    </B>
                    <L>
                        <A Name="MDLN">
                            <Value>QODERSECS-M1</Value>
                            <Maps Type="4096">
                            </Maps>
                        </A>
                        <A Name="SOFT">
                            <Value>1.0.0</Value>
                            <Maps Type="4096">
                            </Maps>
                        </A>
                    </L>
                </L>
            </Structure>
        </Message>
        <Message Name="S1F15_RequestOffline" Description="">
            <Stream>1</Stream>
            <Function>15</Function>
            <WBit>1</WBit>
            <AutoReply>S1F16_RequestOfflineAck</AutoReply>
            <Structure />
        </Message>
        <Message Name="S1F16_RequestOfflineAck" Description="OFLACK=0 表示接受">
            <Stream>1</Stream>
            <Function>16</Function>
            <Structure>
                <B Name="OFLACK">
                    <Value>00</Value>
                    <Maps Type="1024">
                    </Maps>
                </B>
            </Structure>
        </Message>
        <Message Name="S1F17_RequestOnline" Description="">
            <Stream>1</Stream>
            <Function>17</Function>
            <WBit>1</WBit>
            <AutoReply>S1F18_RequestOnlineAck</AutoReply>
            <Structure />
        </Message>
        <Message Name="S1F18_RequestOnlineAck" Description="ONLACK=0 表示不接受，1 表示不接受但会自己上线，2 表示接受">
            <Stream>1</Stream>
            <Function>18</Function>
            <Structure>
                <B Name="ONLACK">
                    <Value>02</Value>
                    <Maps Type="1024">
                    </Maps>
                </B>
            </Structure>
        </Message>
        <Message Name="S2F31_DateTimeSet" Description="">
            <Stream>2</Stream>
            <Function>31</Function>
            <WBit>1</WBit>
            <AutoReply>S2F32_DateTimeSetAck</AutoReply>
            <Structure>
                <A Name="DATETIME">
                    <Value>20261015120000</Value>
                    <Maps Type="4096">
                    </Maps>
                </A>
            </Structure>
        </Message>
        <Message Name="S2F32_DateTimeSetAck" Description="">
            <Stream>2</Stream>
            <Function>32</Function>
            <Structure />
        </Message>
        <Message Name="S2F41_HostCommand" Description="HCID 加参数表">
            <Stream>2</Stream>
            <Function>41</Function>
            <WBit>1</WBit>
            <AutoReply>S2F42_HostCommandAck</AutoReply>
            <Structure>
                <L>
                    <A Name="HCID">
                        <Value>START_LOT</Value>
                        <Maps Type="4096">
                        </Maps>
                    </A>
                    <L Name="CPList">
                        <L>
                            <A Name="CPNAME">
                                <Value>LOT_ID</Value>
                                <Maps Type="4096">
                                </Maps>
                            </A>
                            <A Name="CPVAL">
                                <Value>LOT-0001</Value>
                                <Maps Type="4096">
                                </Maps>
                            </A>
                        </L>
                        <L>
                            <A Name="CPNAME">
                                <Value>RECIPE</Value>
                                <Maps Type="4096">
                                </Maps>
                            </A>
                            <A Name="CPVAL">
                                <Value>RC-DEMO-01</Value>
                                <Maps Type="4096">
                                </Maps>
                            </A>
                        </L>
                    </L>
                </L>
            </Structure>
        </Message>
        <Message Name="S2F42_HostCommandAck" Description="HCACK=0 表示命令可执行">
            <Stream>2</Stream>
            <Function>42</Function>
            <Structure>
                <L>
                    <B Name="HCACK">
                        <Value>00</Value>
                        <Maps Type="1024">
                        </Maps>
                    </B>
                    <L Name="CPList">
                        <L>
                            <A Name="CPNAME">
                                <Value>LOT_ID</Value>
                                <Maps Type="4096">
                                </Maps>
                            </A>
                            <B Name="CPACK">
                                <Value>00</Value>
                                <Maps Type="1024">
                                </Maps>
                            </B>
                        </L>
                        <L>
                            <A Name="CPNAME">
                                <Value>RECIPE</Value>
                                <Maps Type="4096">
                                </Maps>
                            </A>
                            <B Name="CPACK">
                                <Value>00</Value>
                                <Maps Type="1024">
                                </Maps>
                            </B>
                        </L>
                    </L>
                </L>
            </Structure>
        </Message>
        <Message Name="S5F1_AlarmReport" Description="ALID 最高位为 1 表示告警发生">
            <Stream>5</Stream>
            <Function>1</Function>
            <WBit>1</WBit>
            <AutoReply>S5F2_AlarmReportAck</AutoReply>
            <Structure>
                <L>
                    <B Name="ALID">
                        <Value>87D1</Value>
                        <Maps Type="1024">
                        </Maps>
                    </B>
                    <A Name="ALTEXT">
                        <Value>BOND FORCE OUT OF RANGE</Value>
                        <Maps Type="4096">
                        </Maps>
                    </A>
                </L>
            </Structure>
        </Message>
        <Message Name="S5F2_AlarmReportAck" Description="">
            <Stream>5</Stream>
            <Function>2</Function>
            <Structure>
                <B Name="ACK">
                    <Value>00</Value>
                    <Maps Type="1024">
                    </Maps>
                </B>
            </Structure>
        </Message>
        <Message Name="S6F11_EventReport" Description="CEID 加报告内容">
            <Stream>6</Stream>
            <Function>11</Function>
            <WBit>1</WBit>
            <AutoReply>S6F12_EventReportAck</AutoReply>
            <Structure>
                <L>
                    <U4 Name="DATAID">
                        <Value>0</Value>
                        <Maps Type="64">
                        </Maps>
                    </U4>
                    <U4 Name="CEID">
                        <Value>1001</Value>
                        <Maps Type="64">
                        </Maps>
                    </U4>
                    <L Name="ReportList">
                        <L>
                            <U4 Name="SVID">
                                <Value>10001</Value>
                                <Maps Type="64">
                                </Maps>
                            </U4>
                            <A Name="Value">
                                <Value>LOT-0001</Value>
                                <Maps Type="4096">
                                </Maps>
                            </A>
                        </L>
                    </L>
                </L>
            </Structure>
        </Message>
        <Message Name="S6F12_EventReportAck" Description="">
            <Stream>6</Stream>
            <Function>12</Function>
            <Structure>
                <B Name="ACK">
                    <Value>00</Value>
                    <Maps Type="1024">
                    </Maps>
                </B>
            </Structure>
        </Message>
    </MessageDictionary>
</SXML>
